{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": ["${mod_authors}"],
	"contact": {
		"sources": "https://github.com/Consterna/ModpackES"
	},
	"license": "${mod_license}",
	"environment": "client",
	"entrypoints": {
		"client": ["io.github.consterna.modpackes.ModpackESRuntime"]
	},
	"depends": {
		"fabricloader": ">=0.14.0",
		"minecraft": "${minecraft_version}",
		"java": ">=17",
		"fabric-message-api-v1": "*",
		"fabric-screen-api-v1": "*",
		"fabric-item-api-v1": "*",
		"fabric-resource-loader-v0": "*"
	}
}
